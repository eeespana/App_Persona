<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Registro de personas</title>
  <style>
    :root {
      --fondo: #f5f7f6;
      --tarjeta: #ffffff;
      --texto: #1c2a26;
      --suave: #5b6b66;
      --borde: #cfd8d4;
      --acento: #1f6f5c;
      --error: #b3261e;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 24px;
      padding: 24px;
      background: var(--fondo);
      color: var(--texto);
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    }
    main, section {
      width: 100%;
      max-width: 480px;
      background: var(--tarjeta);
      border: 1px solid var(--borde);
      border-radius: 10px;
      padding: 28px;
    }
    h1 { margin: 0 0 20px; font-size: 1.4rem; }
    h2 { margin: 0 0 16px; font-size: 1.1rem; }
    label { display: block; margin-bottom: 16px; font-size: .9rem; color: var(--suave); }
    input {
      display: block;
      width: 100%;
      margin-top: 6px;
      padding: 10px 12px;
      font: inherit;
      color: var(--texto);
      border: 1px solid var(--borde);
      border-radius: 6px;
    }
    input:focus-visible, button:focus-visible {
      outline: 2px solid var(--acento);
      outline-offset: 2px;
    }
    button {
      padding: 11px;
      font: inherit;
      font-weight: 600;
      color: #fff;
      background: var(--acento);
      border: 0;
      border-radius: 6px;
      cursor: pointer;
    }
    button:disabled { opacity: .6; cursor: wait; }
    #formulario button { width: 100%; }
    .fila-botones { display: flex; gap: 10px; margin-top: 6px; }
    .fila-botones button { flex: 1; }
    #cancelar { background: var(--suave); }

    #mensaje { min-height: 1.4em; margin: 14px 0 0; font-size: .9rem; }
    #mensaje.ok { color: var(--acento); }
    #mensaje.error { color: var(--error); }

    table { width: 100%; border-collapse: collapse; font-size: .85rem; }
    th, td { text-align: left; padding: 8px 6px; border-bottom: 1px solid var(--borde); }
    th { color: var(--suave); font-weight: 600; }
    td button {
      padding: 5px 9px;
      font-size: .8rem;
      margin-right: 4px;
      background: var(--acento);
    }
    td button.eliminar { background: var(--error); }
    #listaEstado { font-size: .85rem; color: var(--suave); margin-top: 10px; }
  </style>
</head>
<body>
  <main>
    <h1 id="tituloFormulario">Registrar persona</h1>

    <form id="formulario">
      <input type="hidden" id="idEditar" value="">
      <label>Cédula
        <input id="cedula" name="cedula" required autocomplete="off">
      </label>
      <label>Nombre
        <input id="nombre" name="nombre" required autocomplete="off">
      </label>
      <label>Apellido
        <input id="apellido" name="apellido" required autocomplete="off">
      </label>
      <div class="fila-botones">
        <button id="guardar" type="submit">Guardar persona</button>
        <button id="cancelar" type="button" style="display:none">Cancelar</button>
      </div>
    </form>

    <p id="mensaje" role="status"></p>
  </main>

  <section>
    <h2>Personas guardadas</h2>
    <table>
      <thead>
        <tr><th>ID</th><th>Cédula</th><th>Nombre</th><th>Apellido</th><th></th></tr>
      </thead>
      <tbody id="cuerpoTabla"></tbody>
    </table>
    <p id="listaEstado">Cargando...</p>
  </section>

  <!-- Librería de Supabase -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script>
    // 1. Pega aquí los datos de tu proyecto (Project Settings > API)
    const SUPABASE_URL = "https://iosknxdlemdlrsvglwhc.supabase.co";
    const SUPABASE_ANON_KEY = "sb_publishable_0xkrUDuvP7R9BuXWaaZzsA_kh9RfBuu";

    const db = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    const formulario = document.getElementById("formulario");
    const boton = document.getElementById("guardar");
    const botonCancelar = document.getElementById("cancelar");
    const titulo = document.getElementById("tituloFormulario");
    const mensaje = document.getElementById("mensaje");
    const cuerpoTabla = document.getElementById("cuerpoTabla");
    const listaEstado = document.getElementById("listaEstado");
    const idEditar = document.getElementById("idEditar");
    const campoCedula = document.getElementById("cedula");
    const campoNombre = document.getElementById("nombre");
    const campoApellido = document.getElementById("apellido");

    function mostrar(texto, tipo) {
      mensaje.textContent = texto;
      mensaje.className = tipo;
    }

    function limpiarFormulario() {
      formulario.reset();
      idEditar.value = "";
      titulo.textContent = "Registrar persona";
      boton.textContent = "Guardar persona";
      botonCancelar.style.display = "none";
    }

    async function cargarPersonas() {
      listaEstado.textContent = "Cargando...";
      const { data, error } = await db
        .from("persona")
        .select("*")
        .order("id", { ascending: false });

      if (error) {
        listaEstado.textContent = "No se pudo cargar la lista: " + error.message;
        return;
      }

      cuerpoTabla.innerHTML = "";
      data.forEach((p) => {
        const fila = document.createElement("tr");
        fila.innerHTML = `
          <td>${p.id}</td>
          <td>${p.cedula}</td>
          <td>${p.nombre}</td>
          <td>${p.apellido}</td>
          <td>
            <button type="button" class="editar" data-id="${p.id}" data-cedula="${p.cedula}" data-nombre="${p.nombre}" data-apellido="${p.apellido}">Editar</button>
            <button type="button" class="eliminar" data-id="${p.id}">Eliminar</button>
          </td>`;
        cuerpoTabla.appendChild(fila);
      });

      listaEstado.textContent = data.length
        ? `${data.length} persona(s) registrada(s).`
        : "Aún no hay personas registradas.";
    }

    formulario.addEventListener("submit", async (evento) => {
      evento.preventDefault();
      boton.disabled = true;

      const persona = {
        cedula: campoCedula.value.trim(),
        nombre: campoNombre.value.trim(),
        apellido: campoApellido.value.trim(),
      };

      let error;
      if (idEditar.value) {
        mostrar("Actualizando...", "");
        ({ error } = await db.from("persona").update(persona).eq("id", idEditar.value));
      } else {
        mostrar("Guardando...", "");
        ({ error } = await db.from("persona").insert(persona));
      }

      if (error) {
        mostrar("No se pudo guardar: " + error.message, "error");
      } else {
        mostrar(idEditar.value ? "Persona actualizada." : "Persona guardada.", "ok");
        limpiarFormulario();
        cargarPersonas();
      }
      boton.disabled = false;
    });

    botonCancelar.addEventListener("click", () => {
      limpiarFormulario();
      mostrar("", "");
    });

    cuerpoTabla.addEventListener("click", async (evento) => {
      const el = evento.target;

      if (el.classList.contains("editar")) {
        idEditar.value = el.dataset.id;
        campoCedula.value = el.dataset.cedula;
        campoNombre.value = el.dataset.nombre;
        campoApellido.value = el.dataset.apellido;
        titulo.textContent = "Editar persona";
        boton.textContent = "Actualizar persona";
        botonCancelar.style.display = "block";
        campoCedula.focus();
        window.scrollTo({ top: 0, behavior: "smooth" });
      }

      if (el.classList.contains("eliminar")) {
        const id = el.dataset.id;
        if (!confirm("¿Eliminar esta persona?")) return;
        el.disabled = true;
        const { error } = await db.from("persona").delete().eq("id", id);
        if (error) {
          mostrar("No se pudo eliminar: " + error.message, "error");
          el.disabled = false;
        } else {
          mostrar("Persona eliminada.", "ok");
          cargarPersonas();
        }
      }
    });

    cargarPersonas();
  </script>
</body>
</html>
